modules = ["nodejs-24", "postgresql-16"]

  [[artifacts]]
  id = "artifacts/api-server"

  [[artifacts]]
  id = "artifacts/mockup-sandbox"

  [[artifacts]]
  id = "artifacts/halal-grocery"

  [deployment]
  router = "application"
  deploymentTarget = "autoscale"

  [deployment.postBuild]
  args = ["pnpm", "store", "prune"]
  env = { "CI" = "true" }

  [workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/halal-grocery run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

  [agent]
  stack = "BEST_EFFORT_FALLBACK"
expertMode = true
  integrations = ["javascript_openai_ai_integrations:2.0.0"]

  [postMerge]
  path = "scripts/post-merge.sh"
  timeoutMs = 20000

  [nix]
  channel = "stable-25_05"

  [userenv]

  [userenv.shared]
  NEON_URL = "postgresql://neondb_owner:npg_hKU8ArzWRe0C@ep-plain-shape-angdqxia.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require"
  NODE_ENV = "development"
  LOG_LEVEL = "info"
  FAST_DELIVERY_CHARGE = "5.00"
  OTP_EXPIRY_MINUTES = "10"
  OTP_LENGTH = "6"
RESEND_API_KEY = "re_3XgEMxh8_8bhgcRqLmsBSsnysPdVLp6ox"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080
  